<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.GameDex" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#0B0D18</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.GameDex.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0B0D18</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.GameDex</item>
    </style>
</resources>

